# Dhanvi Fastify API / worker — copy to backend/.env for `npm run dev` and `npm run worker`. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info
SWAGGER_ENABLED=true

DATABASE_URL=postgres://dhanvi:change-me-for-local-development@localhost:5432/dhanvi
DATABASE_POOL_MAX=20
RUN_MIGRATIONS_ON_START=false

REDIS_URL=redis://localhost:6379

JWT_SIGNING_KEY=
JWT_ISSUER=Dhanvi
JWT_AUDIENCE=Dhanvi.Web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_SECURE_COOKIES=false

FRONTEND_ORIGIN=http://localhost:3000;http://localhost:3001
# Development/test only; production is always 20–50.
GROUP_POLICY_MIN_MEMBERS=2

DHANVI_SEED_ADMIN_ENABLED=false
DHANVI_SEED_ADMIN_EMAIL=
DHANVI_SEED_ADMIN_PASSWORD=

PAYMENTS_RAZORPAY_ENABLED=false
RAZORPAY_ENVIRONMENT=TEST
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOKS_ENABLED=true

PAYOUTS_PROVIDER=FAKE
PAYOUTS_FAKE_OUTCOME=Success
LEDGER_FEE_RECOGNITION=Deferred

# Digital auction closing sequence (seconds per phase) and the BullMQ safety-net sweep.
AUCTION_AUTOMATION_ENABLED=true
AUCTION_GOING_ONCE_SECONDS=30
AUCTION_GOING_TWICE_SECONDS=30
AUCTION_FINAL_WARNING_SECONDS=30
AUCTION_SWEEP_INTERVAL_SECONDS=15

# Optional automatic payment/payout reconciliation (off = operator-triggered only, as in the .NET backend).
RECONCILIATION_SWEEP_ENABLED=false
RECONCILIATION_SWEEP_INTERVAL_SECONDS=300
WORKER_CONCURRENCY=4
